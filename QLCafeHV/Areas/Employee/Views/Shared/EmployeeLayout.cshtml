<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/style.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/css/table.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

    <div class="top-menu">
        <div title="Trang chủ">🏠</div>
        <div>Sổ giao hàng</div>
        <div style="flex-grow:1"></div>

        <div id="btnTodaySales" style="cursor:pointer;">
            Doanh số hôm nay
        </div>

        <button type="button"
                class="btn btn-link text-danger"
                onclick="onLogoutClick()">
            <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
        </button>
    </div>

    @RenderBody()

    <!-- Modal phải đặt ngoài top-menu -->
    <div class="modal fade" id="todaySalesModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Doanh số hôm nay</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <p>Tiền mở ca: <span id="openAmount">0</span></p>
                    <p>Doanh thu: <span id="totalSales">0</span></p>
                    <p>Tiền phải có: <span id="expectedAmount">0</span></p>

                    <div class="mb-3">
                        <label>Tiền thực tế:</label>
                        <input type="text" id="actualAmount" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label>Chênh lệch:</label>
                        <input type="text" id="difference" class="form-control" readonly>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/saletoday.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>