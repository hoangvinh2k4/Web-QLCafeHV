<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/style.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/css/table.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

    <div class="top-menu">
        <div title="Trang chủ">🏠</div>
        <button class="btn btn-primary" onclick="openOnlineOrders()">Đơn hàng online</button>
        <button class="btn btn-success" onclick="openOfflineOrders()">Đơn hàng tại quầy</button>
        <div style="flex-grow:1"></div>

        <div id="btnTodaySales" style="cursor:pointer;">
            Doanh số hôm nay
        </div>

        <button type="button"
                class="btn btn-link text-danger"
                onclick="onLogoutClick()">
            <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
        </button>
    </div>

    @RenderBody()

    <!-- Modal phải đặt ngoài top-menu -->
    <div class="modal fade" id="todaySalesModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Doanh số hôm nay</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <p>Tiền mở ca: <span id="openAmount">0</span></p>
                    <p>Doanh thu: <span id="totalSales">0</span></p>
                    <p>Tiền phải có: <span id="expectedAmount">0</span></p>

                    <div class="mb-3">
                        <label>Tiền thực tế:</label>
                        <input type="text" id="actualAmount" class="form-control">
                    </div>

                    <div class="mb-3">
                        <label>Chênh lệch:</label>
                        <input type="text" id="difference" class="form-control" readonly>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <!-- Popup đơn hàng online -->
    <div class="modal fade" id="orderOnlineModal" tabindex="-1">
        <div class="modal-dialog modal-lg">           
            <div class="modal-content">
                <div class="modal-header py-2">
                    <h6 class="modal-title">Đơn hàng online</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-2">
                    <table class="table table-sm table-bordered text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn hàng</th>
                                <th>Tên khách hàng</th>
                                <th>Địa chỉ</th>
                                <th>Số điện thoại</th>
                                <th>Tổng tiền </th>
                            </tr>
                        </thead>
                        <tbody id="modalContentOnline">
                            <!-- PartialView load vào đây -->
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    <!-- Popup đơn hàng offline -->
    <div class="modal fade" id="orderOfflineModal" tabindex="-1">
        <div class="modal-dialog modal-lg">           
            <div class="modal-content">

                <div class="modal-header py-2">
                    <h6 class="modal-title">Đơn tại quầy</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-2">
                    <table class="table table-sm table-bordered text-center mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn hàng</th>
                                <th>Bàn số</th>
                                <th>Tổng tiền</th>
                            </tr>
                        </thead>
                        <tbody id="modalContentOffline">
                            <!-- PartialView load vào đây -->
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/saletoday.js"></script>
    <script src="~/js/order.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
