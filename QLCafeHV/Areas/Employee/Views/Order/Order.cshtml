@model List<QLCafeHV.Models.ProductModel>
@{
    Layout = "~/Areas/Employee/Views/Shared/EmployeeLayout.cshtml";
    ViewData["Title"] = "Menu sản phẩm";
    @using System.Globalization
    CultureInfo.CurrentCulture = new CultureInfo("vi-VN");
}

<!-- Thanh tìm kiếm -->
<div class="search-box">
    <input type="text" id="searchInput" placeholder="Nhập mã/Tên món cần tìm..." />
</div>
<!-- Khu vực nội dung chính -->
<div class="container">
    <div class="food-list" id="foodList">
        @foreach (var product in Model)
        {
            <div class="food-item" data-id="@product.ProductID">
                <img src="@product.ImageUrl" alt="@product.ProductName" />
                <div class="price-tag">@product.Price.ToString("N0")</div>
                <div class="food-name">@product.ProductName</div>
            </div>
        }
    </div>


    <!-- Bảng order món (bên phải) -->
    <div class="order-panel">
        <input type="hidden" id="OrderId" value="@ViewBag.OrderId" />
        <h3 class="table-title">Bàn số @ViewBag.TableNumber</h3>
      <div class="order-body">
        <table>
            <thead>
                <tr>
                    <th>Tên món</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="orderTableBody">
                @if (ViewBag.OrderItems != null)
                {
                    foreach (var item in ViewBag.OrderItems)
                    {
                        <tr>
                                <td class="order-item-name" data-product-id="@item.productId">
                                    <div class="item-name">@item.name</div>

                                    @if (!string.IsNullOrEmpty(item.note))
                                    {
                                        <div class="item-note">📝 @item.note</div>
                                    }
                                </td>


                            <td>
                                <div class="qty-control" style="display:flex; align-items:center;">
                                    <button class="btn-decrease" data-product-id="@item.productId">-</button>
                                    <input type="number" class="qty-input" data-product-id="@item.productId" value="@item.qty" min="1" style="width:50px; text-align:center; margin:0 4px;" />
                                    <button class="btn-increase" data-product-id="@item.productId">+</button>
                                </div>
                            </td>

                            <td>@String.Format("{0:N0}", item.unitprice)</td>
                            <td>@String.Format("{0:N0}", item.total)</td>
                            <td>
                                <button class="btn btn-sm btn-danger btnDelete"
                                        data-order-id="@ViewBag.OrderId"
                                        data-product-id="@item.productId">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
       </div>
        <input type="hidden" id="AppliedDiscountCode" />
        <div class="mt-3 d-flex justify-content-between align-items-center">
            <label style="font-weight:500;">Mã giảm giá:</label>

            <div style="display:flex; gap:8px;">
                <input type="text" id="discountCode" class="form-control" placeholder="Nhập mã" style="width:180px;" />
                <button id="btnApplyDiscount" class="btn btn-success">
                    Áp dụng
                </button>
            </div>
        </div>
        <!-- Dropdown phương thức thanh toán --> 
        <div class="mt-3 d-flex justify-content-end align-items-center">
            <label for="paymentMethod" style="margin-right:10px; font-weight:500;">Phương thức thanh toán:</label> 
            <select id="paymentMethod" class="form-select" style="width:200px;"> 
                <option value="Tiền mặt">Tiền mặt</option> 
                <option value="Chuyển khoản">Chuyển khoản</option>  
            </select> 
        </div>

        <!-- Tổng tiền -->
        <div style="font-weight: 700; font-size: 14px; margin-top: 8px;">
            <div style="display: flex; justify-content: space-between; margin: 4px 0;">
                <div>Tổng thanh toán</div>
                <div id="totalAmount">@String.Format("{0:N0}", ViewBag.TotalAmount ?? 0) </div>
            </div>
        </div>

        <!-- Nút chức năng cuối cùng -->
        <div class="bottom-buttons" style="margin-top: 12px;">
            <button class="btn btn-warning" onclick="openMergeTable(@ViewBag.TableId)">
                <i class="fa-solid fa-code-merge"></i> Gộp bàn
            </button>
            <a asp-controller="Home" asp-action="Index" asp-area="Employee" class="btn btn-red">Hủy bỏ</a>
            <button id="btnCancelOrder" class="btn btn-orange">Hủy đơn</button>
            <button id="btnPay" class="btn btn-blue">Thu tiền</button>
        </div>
        <!--Popup gộp bàn -->
        <div class="modal fade" id="mergeModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Chọn bàn để gộp</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">
                        <select id="mergeTableSelect" class="form-control"></select>
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-primary" onclick="confirmMerge()">Xác nhận</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@section Scripts{
<script>
    $(document).ready(function () {

        // ====================== THÊM MÓN ======================
        $(".food-item").click(function () {
            var productId = $(this).data("id");
            var orderId = $("#OrderId").val();

            $.post("/Employee/Order/AddItem", { orderId: orderId, productId: productId }, function (items) {
                renderOrderTable(items);
            });
        });

        // ====================== XÓA MÓN ======================
        $(document).on("click", ".btnDelete", function () {
            var orderId = $(this).data("order-id");
            var productId = $(this).data("product-id");
            var row = $(this).closest("tr");

            $.post("/Employee/Order/RemoveItem", { orderId: orderId, productId: productId }, function (items) {
                row.remove();
                Swal.fire({
                    icon: "success",
                    title: "Đã xóa món!",
                    timer: 1000,
                    showConfirmButton: false
                });
                renderOrderTable(items);
            });
        });

             // ====================== HỦY ĐƠN HÀNG ======================
    $("#btnCancelOrder").click(function () {
        var orderId = $("#OrderId").val();

        Swal.fire({
            title: "Xác nhận hủy đơn hàng",
            text: "Bạn có chắc chắn muốn hủy đơn hàng này?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Hủy đơn",
            cancelButtonText: "Đóng"
        }).then((result) => {

            if (result.isConfirmed) {
                $.post("/Employee/Order/CancelOrder", { orderId: orderId }, function (res) {

                    if (res.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Đơn hàng đã được hủy!",
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = "/Employee/Home/Index";
                        });

                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Lỗi",
                            text: res.message
                        });
                    }

                });
            }

        });
    });

        // ====================== CẬP NHẬT SL ======================
        $(document).on("click", ".btn-increase", function () {
            var productId = $(this).data("product-id");
            var input = $(".qty-input[data-product-id='" + productId + "']");
            input.val(parseInt(input.val()) + 1);
            updateQuantity(productId, parseInt(input.val()));
        });

        $(document).on("click", ".btn-decrease", function () {
            var productId = $(this).data("product-id");
            var input = $(".qty-input[data-product-id='" + productId + "']");
            if (parseInt(input.val()) > 1) {
                input.val(parseInt(input.val()) - 1);
                updateQuantity(productId, parseInt(input.val()));
            }
        });

        $(document).on("change", ".qty-input", function () {
            var productId = $(this).data("product-id");
            var qty = parseInt($(this).val());
            if (qty < 1) $(this).val(1);
            updateQuantity(productId, parseInt($(this).val()));
        });

        function updateQuantity(productId, qty) {
            var orderId = $("#OrderId").val();
            $.post("/Employee/Order/UpdateQuantity", { orderId: orderId, productId: productId, quantity: qty }, function (items) {
                renderOrderTable(items);
            });
        }
                // ====================== ÁP MGG ======================
    $('#btnApplyDiscount').click(function () {

        let code = $('#discountCode').val();
        let orderId = $('#OrderId').val();

        $.post('/Employee/Order/ApplyDiscount',
            {
                orderId: orderId,
                code: code
            },
            function (res) {
                if (res.success) {

                    $('#totalAmount').text(res.newTotal);

                    // Lưu mã để thanh toán dùng lại
                    $('#AppliedDiscountCode').val(code);

                    // Khóa nút tránh áp 2 lần
                    $('#btnApplyDiscount').prop('disabled', true);

                    Swal.fire({
                        title: 'Thành công',
                        text: res.message,
                        icon: 'success',
                        timer: 2000,
                        showConfirmButton: false
                    });

                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
    });
        // ====================== THANH TOÁN ======================
    $("#btnPay").click(function () {

        var orderId = $("#OrderId").val();
        var paymentMethod = $("#paymentMethod").val();
        var discountCode = $("#AppliedDiscountCode").val();

        $.post("/Employee/Order/PayOrder",
            {
                orderId: orderId,
                paymentMethod: paymentMethod,
                discountCode: discountCode
            },
            function (res) {
                if (res.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Thanh toán thành công!",
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = "/Employee/Home/Index";
                    });
                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Lỗi",
                        text: res.message
                    });
                }
            });
    });

    });
        $(document).on("click", ".order-item-name", function () {
        const productId = $(this).data("product-id");
        const orderId = $("#OrderId").val();

        Swal.fire({
            title: "Ghi chú món",
            input: "text",
            inputPlaceholder: "Ví dụ: ít đá, không đường...",
            showCancelButton: true,
            confirmButtonText: "Lưu",
            cancelButtonText: "Hủy"
        }).then((result) => {
            if (result.isConfirmed) {
                $.post("/Employee/Order/UpdateNote", {
                    orderId: orderId,
                    productId: productId,
                    note: result.value
                }, function (items) {
                    renderOrderTable(items);
                });
            }
        });
    });
     function renderOrderTable(list) {
            console.log(list);
            var html = "";
            var total = 0;
            if (!list) return;

            list.forEach(function (item) {
                html += `
                    <tr>
                        <td class="order-item-name" data-product-id="${item.productId}">
                             <div class="item-name">${item.name}</div>
                             ${item.note ? `<div class="item-note">📝 ${item.note}</div>` : ``}
                        </td>
                        <td>
                            <div class="qty-control" style="display:flex; align-items:center;">
                                <button class="btn-decrease" data-product-id="${item.productId}">-</button>
                                <input type="number" class="qty-input" data-product-id="${item.productId}" value="${item.qty}" min="1" style="width:50px; text-align:center; margin:0 4px;" />
                                <button class="btn-increase" data-product-id="${item.productId}">+</button>
                            </div>
                        </td>
                        <td>${item.unitprice.toLocaleString("vi-VN")} </td>
                        <td>${item.total.toLocaleString("vi-VN")} </td>
                        <td>
                            <button class="btn btn-danger btn-sm btnDelete" data-order-id="${$("#OrderId").val()}" data-product-id="${item.productId}">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>`;
                total += item.total;
            });

            $("#orderTableBody").html(html);
            $("#totalAmount").text(total.toLocaleString("vi-VN"));
            $("#amountToPay").text(total.toLocaleString("vi-VN"));
        }
        // ====================== GỘP BÀN ======================
        let currentTableId = 0;
        function openMergeTable(tableId) {

        currentTableId = tableId;

        $.get('/Employee/Merge/GetOccupiedTables', { currentTableId: tableId }, function (data) {

            $('#mergeTableSelect').empty();

            data.forEach(item => {
                $('#mergeTableSelect').append(
                    `<option value="${item.tableID}">${item.tableName}</option>`
                );
            });

            $('#mergeModal').modal('show');
        });
    }
        function confirmMerge() {

        let sourceTableId = $('#mergeTableSelect').val();

        $.post('/Employee/Merge/MergeTables',
    {
        targetTableId: currentTableId,
        sourceTableId: sourceTableId
    },
         function (res) {
           if (res.success) {
            Swal.fire({
                title: 'Thành công',
                text: res.message,
                icon: 'success',
                timer: 2500,
                showConfirmButton: false
            }).then(() => {
                location.reload();
            });

        }
    });  
</script>
}

