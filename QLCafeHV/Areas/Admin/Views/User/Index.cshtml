@model QLCafeHV.Models.ViewModels.PageViewModel<QLCafeHV.Models.ViewModels.UserAccountViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    var keyword = Context.Request.Query["keyword"];
}
<h2>Danh sách người dùng</h2>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input name="keyword"
                   value="@keyword"
                   class="form-control"
                   placeholder="Tìm theo tài khoản người dùng, tên..." />
        </div>
        <div class="col-md-4 d-flex">
            <button class="btn btn-primary me-2">Tìm kiếm</button>

            @if (!string.IsNullOrEmpty(keyword))
            {
                <a asp-area="Admin" asp-controller="User" asp-action="Index"
                   class="btn btn-secondary">
                    Quay về danh sách đầy đủ
                </a>
            }
        </div>
    </div>
</form>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên người dùng</th>
            <th>Số điện thoại</th>
            <th>Địa chỉ</th>
            <th>Căn cước công dân</th>
            <th>Tên đăng nhập</th>
            <th>Mật khẩu</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Employee.FullName</td>
                <td>@item.Employee.Phone</td>
                <td>@item.Employee.Address</td>
                <td>@item.Employee.Cccd</td>
                <td>@item.Account.Username</td>
                <td>@item.Account.PasswordHash</td>
                <td>
                    <button class="btn btn-sm btn-danger btnDelete" data-id="@item.Employee.EmployeeID">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<nav>
    <ul class="pagination">

        <!-- Nút Previous -->
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PageNumber - 1)">«</a>
        </li>

        <!-- Danh sách trang -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?page=@i">@i</a>
            </li>
        }

        <!-- Nút Next -->
        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PageNumber + 1)">»</a>
        </li>

    </ul>
</nav>

@section Scripts {
    <script>
        $(".btnDelete").click(function () {
            var id = $(this).data("id");
            var row = $(this).closest("tr");

            Swal.fire({
                title: 'Bạn có chắc muốn xóa?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Employee", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                row.remove();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi!',
                                    text: res.message
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi server',
                                text: 'Không thể xóa sản phẩm!'
                            });
                        }
                    });
                }
            });
        });
    </script>
}

