@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<h3 class="mb-4"><i class="fa-solid fa-chart-line text-primary"></i> Dashboard tổng quan</h3>

<!-- 4 Cards -->
<div class="row g-3">
    <div class="col-md-3">
        <div class="card card-custom border-primary shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4>@ViewBag.TotalOrders</h4>
                    <p>Đơn hàng hôm nay</p>
                </div>
                <i class="fa-solid fa-file-invoice card-icon text-primary"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom border-success shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4>@String.Format("{0:N0} đ", ViewBag.TotalRevenue)</h4>
                    <p>Doanh thu hôm nay</p>
                </div>
                <i class="fa-solid fa-coins card-icon text-success"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom border-warning shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4>@ViewBag.TotalItems</h4>
                    <p>Sản phẩm đã bán</p>
                </div>
                <i class="fa-solid fa-cubes card-icon text-warning"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom border-info shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4>@DateTime.Now.ToString("HH:mm")</h4>
                    <p>Thời gian hiện tại</p>
                </div>
                <i class="fa-solid fa-clock card-icon text-info"></i>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ -->
<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h5>📊 Doanh thu 12 tháng trong năm</h5>
        <canvas id="monthChart" height="100"></canvas>
    </div>
</div>

<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h5>📈 Doanh thu theo ngày trong tháng</h5>
        <canvas id="dayChart" height="100"></canvas>
    </div>
</div>

<!-- Top sản phẩm -->
<div class="card mt-4 shadow-sm">
    <div class="card-body">
        <h5>🏆 Top sản phẩm bán chạy hôm nay</h5>
        <table class="table mt-2">
            <thead class="table-light">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Số lượng bán</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in ViewBag.TopProducts)
                {
                    <tr>
                        <td>@p.ProductName</td>
                        <td>@p.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const monthLabels = [
        @Html.Raw(string.Join(",", ((IEnumerable<dynamic>)ViewBag.MonthlyRevenue)
                        .Select(x => $"'Tháng {x.Month}'")))
    ];

    const monthData = [
        @Html.Raw(string.Join(",", ((IEnumerable<dynamic>)ViewBag.MonthlyRevenue)
                        .Select(x => x.Revenue)))
    ];

    let dayChart;

    const monthChart = new Chart(document.getElementById('monthChart'), {
        type: 'bar',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Doanh thu tháng',
                data: monthData
            }]
        },
        options: {
            onClick: function(e, elements) {
                if (elements.length > 0) {
                    const index = elements[0].index;
                    const month = index + 1;
                    loadDailyRevenue(month);
                }
            }
        }
    });

    function loadDailyRevenue(month) {
        fetch('/Admin/Home/GetRevenueByMonth?month=' + month)
            .then(res => res.json())
            .then(data => {

                const labels = data.map(x => x.day);
                const revenues = data.map(x => x.revenue);

                if (dayChart) {
                    dayChart.destroy();
                }

                dayChart = new Chart(document.getElementById('dayChart'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Doanh thu theo ngày',
                            data: revenues
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            x: {
                                ticks: {
                                    maxRotation: 0,
                                    minRotation: 0
                                }
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return value.toLocaleString('vi-VN') + 'đ';
                                    }
                                }
                            }
                        }
                    }
                });
            });
    }

    loadDailyRevenue(new Date().getMonth() + 1);
</script>
}
