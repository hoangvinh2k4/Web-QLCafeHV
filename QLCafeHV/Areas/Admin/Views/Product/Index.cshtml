@model QLCafeHV.Models.ViewModels.PageViewModel<QLCafeHV.Models.ProductModel>
@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    var keyword = Context.Request.Query["keyword"];
}

<h2>Danh sách sản phẩm</h2>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input name="keyword"
                   value="@keyword"
                   class="form-control"
                   placeholder="Tìm theo mã sản phẩm, tên..." />
        </div>
        <div class="col-md-4 d-flex">
            <button class="btn btn-primary me-2">Tìm kiếm</button>

            @if (!string.IsNullOrEmpty(keyword))
            {
                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                   class="btn btn-secondary">
                    Quay về danh sách đầy đủ
                </a>
            }
        </div>
    </div>
</form>


<a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-primary mb-3">
    + Thêm sản phẩm
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên</th>
            <th>Danh mục</th>
            <th>Giá</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Ngày chỉnh sửa</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" width="80" height="60" style="border-radius:5px;" />
                    }
                </td>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>@(item.Status == 1 ? "Còn bán" : "Ngừng bán")</td>
                <td>@item.CreatedTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.UpdatedTime.HasValue? item.UpdatedTime.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>

                <td>
                    <!-- Edit -->
                    <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@item.ProductID" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i>
                    </a>

                    <!-- Delete -->
                    <button class="btn btn-sm btn-danger btnDelete" data-id="@item.ProductID">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
<nav>
    <ul class="pagination">

        <!-- Nút Previous -->
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PageNumber - 1)">«</a>
        </li>

        <!-- Danh sách trang -->
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?page=@i">@i</a>
            </li>
        }

        <!-- Nút Next -->
        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PageNumber + 1)">»</a>
        </li>

    </ul>
</nav>
@section Scripts {
    <script>
               $(".btnDelete").click(function () {

            var id = $(this).data("id");
            var row = $(this).closest("tr");

            Swal.fire({
                title: 'Bạn có chắc muốn xóa?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có',
                cancelButtonText: 'Hủy'
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: '/api/ProductApi/Delete',
                        type: 'POST',                    
                        data: { id: id },

                        success: function (res) {

                            if (res.message) {

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });

                                row.remove();
                            }
                            else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi!',
                                    text: res.message
                                });
                            }
                        },

                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi server',
                                text: 'Không thể xóa sản phẩm!'
                            });
                        }
                    });
                }
            });
        });
    </script>
}

