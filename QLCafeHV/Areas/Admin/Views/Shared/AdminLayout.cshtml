<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Coffee HV</title>
    <link href="~/css/adminlayout.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  
</head>
<body class="admin-dashboard">
    <!-- Sidebar -->
    <div class="sidebar">
        <h4 class="text-center mb-3"><i class="fa-solid fa-mug-hot"></i> Coffee HV</h4>
        <a href="/admin/home/index" class="active"><i class="fa-solid fa-gauge"></i> Dashboard</a>
        <a asp-controller="Product" asp-action="Index" asp-area="Admin"><i class="fa-solid fa-cube"></i> Sản phẩm</a>
        <a href="/admin/employee/index"><i class="fa-solid fa-user-tie"></i> Nhân viên</a>
        <a href="/admin/order/index"><i class="fa-solid fa-cart-shopping"></i> Đơn hàng</a>
        <hr style="border-color: #475569;">
        <a asp-controller="Auth" asp-action="Logout" asp-area="">
            <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
        </a>
    </div>

    <!-- Content -->
    <div class="main-content">
        <div class="topbar d-flex justify-content-between align-items-center">
            <h5 class="m-0">Xin chào, Admin 👋</h5>
            <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        </div>

        <div class="content-body">
            @RenderBody()
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
