@model List<SalaryModel>
@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Bảng lương";
}

<h2 style="margin-bottom:20px;">Bảng lương nhân viên</h2>

<table class="table table-bordered">
    <tr>
        <th>Nhân viên</th>
        <th>Tháng</th>
        <th>Tổng giờ</th>
        <th>Lương cơ bản</th>
        <th>Thưởng</th>
        <th>Phạt</th>
        <th>Tổng lương</th>
        <th>Hành động</th>
    </tr>

    @foreach (var item in Model)
    {
        int hours = (int)item.TotalHours;
        int minutes = (int)Math.Round((item.TotalHours - hours) * 60);

        <tr>
            <td>@item.Employee.FullName</td>
            <td>@item.Month/@item.Year</td>
            <td>@hours giờ @minutes phút</td>
            <td>@item.BaseSalary.ToString("N0") VND</td>
            <td>@item.Bonus.ToString("N0") VND</td>
            <td>@item.Penalty.ToString("N0") VND</td>
            <td>@item.TotalSalary.ToString("N0") VND</td>
            <td>
                <button class="btn btn-info btn-sm"
                        onclick="showSalaryDetail(@item.EmployeeID,@item.Month,@item.Year)">
                    Xem chi tiết
                </button>

                <button class="btn btn-success btn-sm"
                        onclick="updateSalary(@item.EmployeeID,@item.Month,@item.Year)">
                    Cập nhật lương
                </button>
            </td>
        </tr>
    }
</table>

<div class="modal fade" id="salaryDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Chi tiết thưởng / phạt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="salaryDetailContent">
                Đang tải...
            </div>
        </div>
    </div>
</div>

<script>
    function showSalaryDetail(employeeId, month, year) {
        $.get('/Admin/Salary/GetSalaryDetail', {
            employeeId: employeeId,
            month: month,
            year: year
        }, function (data) {
            $('#salaryDetailContent').html(data);
            $('#salaryDetailModal').modal('show');
        });
    }

    function updateSalary(employeeId, month, year) {
        if (!confirm('Bạn có chắc muốn cập nhật lương cho nhân viên này không?')) return;

        $.post('/Admin/Salary/CalculateSalaryForEmployee', {
            employeeId: employeeId,
            month: month,
            year: year
        }, function (res) {
            if (res.success) {
                alert('Cập nhật lương thành công!');
                location.reload(); // reload để bảng lương hiển thị mới
            } else {
                alert('Lỗi: ' + res.message);
            }
        });
    }
</script>