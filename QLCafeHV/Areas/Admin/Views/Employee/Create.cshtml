@model QLCafeHV.Models.ViewModels.EmployeeAccountViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Thêm bàn";
}

<h2>Thêm nhân viên và đăng kí tài khoản cho nhân viên</h2>

<form id="createForm" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Tên nhân viên</label>
        <input asp-for="Employee.FullName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Số căn cước công dân</label>
        <input asp-for="Employee.Cccd"
               type="text"
               class="form-control"
               maxlength="12"
               oninput="this.value = this.value.replace(/[^0-9]/g, '');" />

    </div>
    <div class="form-group">
        <label>Địa chỉ</label>
        <input asp-for="Employee.Address" class="form-control" />
    </div>
    <div class="form-group">
        <label>Số điện thoại</label>
        <input asp-for="Employee.Phone"
               type="text"
               class="form-control"
               oninput="this.value = this.value.replace(/[^0-9]/g, '');"
               pattern="0[0-9]{9,10}"/>
    </div>
    <div class="form-group">
        <label>Tên đăng nhập</label>
        <input asp-for="Account.Username" class="form-control" autocomplete="new-password" />
    </div>
    <div class="form-group">
        <label>Mật khẩu</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Xác nhận mật khẩu</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="button" id="btnAdd" class="btn btn-primary mt-3">Thêm nhân viên</button>
    <a asp-controller="Employee" asp-action="Index" asp-area="Admin" class="btn btn-primary mt-3">Quay lại</a>
</form>

@section Scripts {
    <script>
        // AJAX thêm sản phẩm
        $("#btnAdd").click(function () {

                let phone = $("input[name='Employee.Phone']").val();

        if (!/^0[0-9]{9,10}$/.test(phone)) {
            Swal.fire({
                icon: "error",
                text: "Số điện thoại phải bắt đầu bằng 0 và có 10–11 số!"
            });
            return;
        }

            let form = $("#createForm")[0];
            let formData = new FormData(form);

            $.ajax({
                url: '@Url.Action("Create", "Employee", new { area = "Admin" })',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: res.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index", "Employee", new { area = "Admin" })';
                        }, 1500);

                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi!',
                            text: res.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi server',
                        text: 'Không gửi được dữ liệu!'
                    });
                }
            });
        });
    </script>
}
