@model QLCafeHV.Models.EmployeeModel

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<h2>Chỉnh sửa sản phẩm</h2>

<form id="editForm" enctype="multipart/form-data">
    <input type="hidden" asp-for="EmployeeID" />

    <div class="form-group">
        <label>Tên nhân viên</label>
        <input asp-for="FullName" class="form-control" />
    </div>
    <div class="form-group">
        <label>Số căn cước công dân</label>
        <input asp-for="Cccd"
               type="text"
               class="form-control"
               maxlength="12"
               oninput="this.value = this.value.replace(/[^0-9]/g, '');" />

    </div>
    <div class="form-group">
        <label>Địa chỉ</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="form-group">
        <label>Số điện thoại</label>
        <input asp-for="Phone"
               type="text"
               class="form-control"
               oninput="this.value = this.value.replace(/[^0-9]/g, '');"
               pattern="0[0-9]{9,10}" />
    </div>
    <button type="button" id="btnSave" class="btn btn-primary mt-3">Lưu thông tin nhân viên</button>
    <a asp-controller="Employee" asp-action="Index" asp-area="Admin" class="btn btn-primary mt-3">Quay lại</a>
</form>

@section Scripts {
    <script>
        $("#btnSave").click(function () {

            let form = $("#editForm")[0];
            let formData = new FormData(form);

            $.ajax({
                url: "@Url.Action("Edit", "Employee", new { area = "Admin" })",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {

                    if (res.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Thành công!",
                            text: res.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index", "Employee", new { area = "Admin" })';
                        }, 1500);

                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Lỗi!",
                            text: res.message
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Lỗi server",
                        text: "Không gửi được dữ liệu!"
                    });
                }
            });
        });
    </script>
}

