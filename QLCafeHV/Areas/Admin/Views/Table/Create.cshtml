@model QLCafeHV.Models.TableModel

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Thêm bàn";
}

<h2>Thêm bàn</h2>

<form id="createForm" enctype="multipart/form-data">
    <div class="form-group">
        <label>Tên bàn</label>
        <input asp-for="TableName" class="form-control" />
    </div>
    <button type="button" id="btnAdd" class="btn btn-primary mt-3">Thêm bàn</button>
</form>

@section Scripts {
    <script>
        $("#btnAdd").click(function () {

            let tableName = $("#TableName").val();

            // validate nhẹ
            if (!tableName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu dữ liệu',
                    text: 'Vui lòng nhập tên bàn'
                });
                return;
            }

            $.ajax({
                url: "/api/TableApi/Create",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({
                    tableName: tableName
                }),

                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công!',
                            text: res.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index", "Table", new { area = "Admin" })';
                        }, 1500);

                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi!',
                            text: res.message
                        });
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi server',
                        text: 'Không gửi được dữ liệu!'
                    });
                }
            });
        });
    </script>
}
