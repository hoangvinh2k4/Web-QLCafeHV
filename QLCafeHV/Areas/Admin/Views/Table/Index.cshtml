@model List<QLCafeHV.Models.TableModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
}
<h2>Danh sách bàn</h2>

<a asp-area="Admin" asp-controller="Table" asp-action="Create" class="btn btn-primary mb-3">
    + Thêm bàn
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên bàn</th>
            <th>Trạng thái</th>
            <th>Ngày tạo</th>
            <th>Ngày chỉnh sửa</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>             
                <td>@item.TableName</td>
                <td>@item.Status</td>
                <td>@item.CreatedTime.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.UpdatedTime.HasValue? item.UpdatedTime.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>

                <td>
                    <!-- Edit -->
                    <a asp-area="Admin" asp-controller="Table" asp-action="Edit" asp-route-id="@item.TableID" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit"></i>
                    </a>

                    <!-- Delete -->
                    <button class="btn btn-sm btn-danger btnDelete" data-id="@item.TableID">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(".btnDelete").click(function () {
            var id = $(this).data("id");
            var row = $(this).closest("tr");

            Swal.fire({
                title: 'Bạn có chắc muốn xóa?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Table", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                row.remove();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi!',
                                    text: res.message
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi server',
                                text: 'Không thể xóa sản phẩm!'
                            });
                        }
                    });
                }
            });
        });
    </script>
}

