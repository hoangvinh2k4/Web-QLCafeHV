@model QLCafeHV.Models.TableModel

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<h2>Chỉnh sửa bàn</h2>

<form id="editForm" enctype="multipart/form-data">
    <input type="hidden" id="TableID" value="@Model.TableID" />

    <div class="form-group">
        <label>Tên bàn</label>
        <input asp-for="TableName" class="form-control" />
    </div>
    <button type="button" id="btnSave" class="btn btn-primary mt-3">Cập nhật bàn</button>
</form>

@section Scripts {
    <script>
        $("#btnSave").click(function () {

            let id = $("#TableID").val();
            let tableName = $("#TableName").val();

            // validate
            if (!tableName) {
                Swal.fire({
                    icon: "warning",
                    title: "Thiếu dữ liệu",
                    text: "Vui lòng nhập tên bàn"
                });
                return;
            }

            $.ajax({
                url: "/api/TableApi/" + id, 
                type: "PUT",                 
                contentType: "application/json",
                data: JSON.stringify({
                    tableName: tableName
                }),

                success: function (res) {

                    if (res.success) {
                        Swal.fire({
                            icon: "success",
                            title: "Thành công!",
                            text: res.message,
                            timer: 1500,
                            showConfirmButton: false
                        });

                        setTimeout(() => {
                            window.location.href = '@Url.Action("Index", "Table", new { area = "Admin" })';
                        }, 1500);

                    } else {
                        Swal.fire({
                            icon: "error",
                            title: "Lỗi!",
                            text: res.message
                        });
                    }
                },

                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Lỗi server",
                        text: "Không gửi được dữ liệu!"
                    });
                }
            });
        });
    </script>
}

