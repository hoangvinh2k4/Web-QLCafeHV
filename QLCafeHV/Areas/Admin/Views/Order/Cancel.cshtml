@model QLCafeHV.Models.ViewModels.PageViewModel<QLCafeHV.Models.ViewModels.OrderDetailsViewModel>


@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    var keyword = Context.Request.Query["keyword"];
}
<h2>Danh sách đơn hàng bị hủy</h2>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-4">
            <input name="keyword"
                   value="@keyword"
                   class="form-control"
                   placeholder="Tìm theo mã đơn hàng, tên bàn..." />
        </div>
        <div class="col-md-4 d-flex">
            <button class="btn btn-primary me-2">Tìm kiếm</button>

            @if (!string.IsNullOrEmpty(keyword))
            {
                <a asp-area="Admin" asp-controller="Order" asp-action="Cancel"
                   class="btn btn-secondary">
                    Quay về danh sách đầy đủ
                </a>
            }
        </div>
    </div>
</form>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã đơn hàng</th>
            <th>Tên bàn</th>
            <th>Tên nhân viên</th>
            <th>Thời gian bắt đầu phục vụ</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá tiền</th>
            <th>Số lượng</th>
            <th>Tổng tiền</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Items)
        {
            var productCount = order.Items.Count();
            var isFirstRow = true;

            foreach (var product in order.Items)
            {
                <tr>
                    @if (isFirstRow)
                    {
                        <td rowspan="@productCount">@order.OrderID</td>
                        <td rowspan="@productCount">@order.TableName</td>
                        <td rowspan="@productCount">@order.EmployeeName</td>
                        <td rowspan="@productCount">
                            @order.OrderTime.ToString("dd/MM/yyyy HH:mm")
                        </td>
                    }

                    <td>@product.ProductName</td>
                    <td>@product.Category</td>
                    <td>@product.Price.ToString("N0") đ</td>
                    <td>@product.Quantity</td>

                    @if (isFirstRow)
                    {
                        <td rowspan="@productCount">
                            @order.TotalAmount.ToString("N0") đ
                        </td>
                        <td rowspan="@productCount">
                            <button class="btn btn-sm btn-danger btnDelete"
                                    data-id="@order.OrderID">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    }
                </tr>

                isFirstRow = false;
            }
        }
    </tbody>


</table>
<nav>
    <ul class="pagination">

        <!-- Previous -->
        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PageNumber - 1)&keyword=@keyword">«</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                <a class="page-link" href="?page=@i&keyword=@keyword">@i</a>
            </li>
        }

        <!-- Next -->
        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PageNumber + 1)&keyword=@keyword">»</a>
        </li>

    </ul>
</nav>

@section Scripts {
    <script>
        $(".btnDelete").click(function () {
            var id = $(this).data("id");
            var row = $(this).closest("tr");

            Swal.fire({
                title: 'Bạn có chắc muốn xóa?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Order", new { area = "Admin" })',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công!',
                                    text: res.message,
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                                row.remove();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi!',
                                    text: res.message
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi server',
                                text: 'Không thể xóa sản phẩm!'
                            });
                        }
                    });
                }
            });
        });
    </script>
}

