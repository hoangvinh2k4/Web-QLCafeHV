@model DiscountModel

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Bảng mã giảm giá";
}

<h2 style="margin-bottom:20px;">Chỉnh sửa mã giảm giá</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="DiscountId" />

    <div class="mb-2">
        <label>Mã giảm giá</label>
        <input asp-for="Code" class="form-control" />
    </div>
    <div class="mb-2">
        <label>Phần trăm giảm (%)</label>
        <input asp-for="PercentValue" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Số lượng</label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Ngày bắt đầu</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Ngày kết thúc</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Trạng thái</label>
        <select asp-for="Status" class="form-control">
            <option value="1">Hoạt động</option>
            <option value="0">Ngừng</option>
        </select>
    </div>

    <button type="button" id="btnSave" class="btn btn-success">
        Cập nhật
    </button>

</form>
@section Scripts {
    <script>

        $(document).ready(function () {
            $("#btnSave").click(handleUpdate);
        });

        function handleUpdate() {

            let data = getFormData();

            // 👉 chỉ check nhẹ
            if (!data.code) {
                Swal.fire("Thiếu dữ liệu", "Vui lòng nhập mã", "warning");
                return;
            }

            callApi(data);
        }

        function getFormData() {
            return {
                id: $("#DiscountId").val(),
                code: $("#Code").val(),
                percentValue: parseInt($("#PercentValue").val()),
                quantity: parseInt($("#Quantity").val()),
                startDate: $("#StartDate").val(),
                endDate: $("#EndDate").val(),
                status: $("#Status").val(),
            };
        }

        function callApi(data) {

            $.ajax({
                url: "/api/DiscountApi/" + data.id,
                type: "PUT",
                contentType: "application/json",
                data: JSON.stringify(data),

                success: function (res) {

                    if (res.success) {
                        Swal.fire("Thành công", res.message, "success");

                        setTimeout(() => {
                            window.location.href = '/Admin/Discount/Index';
                        }, 1500);

                    } else {
                        // 👉 lỗi từ SERVICE trả về
                        Swal.fire("Lỗi", res.message, "error");
                    }
                },

                error: function (err) {
                    Swal.fire(
                        "Lỗi server",
                        err.responseJSON?.message || "Có lỗi xảy ra",
                        "error"
                    );
                }
            });
        }

    </script>
}
