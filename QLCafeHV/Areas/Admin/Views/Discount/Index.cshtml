@model List<DiscountModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Bảng mã giảm giá";
}

<h2 style="margin-bottom:20px;">Bảng mã giảm giá</h2>
<a asp-area="Admin" asp-controller="Discount" asp-action="Create" class="btn btn-primary mb-3">
	+ Tạo mã giảm giá
</a>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã</th>
            <th>% giảm</th>
            <th>Số lượng</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Code</td>
                <td>@item.PercentValue %</td>
                <td>@item.Quantity</td>
                <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (item.Status == 1)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Ngừng</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DiscountId" class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <button class="btn btn-danger btn-sm btnDelete" data-id="@item.DiscountId">
                        Xóa
                    </button>
                    
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).on("click", ".btnDelete", function () {

            let id = $(this).data("id");
            let row = $(this).closest("tr");

            Swal.fire({
                title: "Bạn có chắc muốn xóa?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Có",
                cancelButtonText: "Hủy"
            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({
                        url: "/api/DiscountApi/Delete/" + id,
                        type: "POST",

                        success: function (res) {
                            if (res.success) {
                                Swal.fire("Thành công", res.message, "success");
                                row.remove();
                            } else {
                                Swal.fire("Lỗi", res.message, "error");
                            }
                        },

                        error: function () {
                            Swal.fire("Lỗi", "Không thể xóa!", "error");
                        }
                    });

                }
            });
        });
    </script>
}