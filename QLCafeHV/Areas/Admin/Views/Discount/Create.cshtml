@model DiscountModel
@{
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "Tạo mã giảm giá";
}

<h2 style="margin-bottom:20px;">Tạo mã giảm giá</h2>

<form id="createForm">

    <div class="mb-2">
        <label>Mã giảm giá</label>
        <input id="Code" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Phần trăm giảm (%)</label>
        <input id="PercentValue" type="number" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Số lượng</label>
        <input id="Quantity" type="number" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Ngày bắt đầu</label>
        <input id="StartDate" type="date" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Ngày kết thúc</label>
        <input id="EndDate" type="date" class="form-control" />
    </div>

    <button type="button" id="btnAdd" class="btn btn-success">
        Tạo mã
    </button>

</form>
@section Scripts {
    <script>

        $(document).ready(function () {
            $("#btnAdd").click(createDiscount);
        });

        function createDiscount() {

            let data = {
                code: $("#Code").val(),
                percentValue: parseInt($("#PercentValue").val()),
                quantity: parseInt($("#Quantity").val()),
                startDate: $("#StartDate").val(),
                endDate: $("#EndDate").val()
            };

            // check nhẹ
            if (!data.code) {
                Swal.fire("Thiếu dữ liệu", "Vui lòng nhập mã giảm giá", "warning");
                return;
            }
            console.log(data);
            $.ajax({
                url: "/api/DiscountApi/Create",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),

                success: function (res) {
                    if (res.success) {
                        Swal.fire("Thành công", res.message, "success");

                        setTimeout(() => {
                            window.location.href = '/Admin/Discount/Index';
                        }, 1500);
                    } else {
                        Swal.fire("Lỗi", res.message, "error");
                    }
                },

                error: function (err) {
                    Swal.fire(
                        "Lỗi server",
                        err.responseJSON?.message || "Có lỗi xảy ra",
                        "error"
                    );
                }
            });
        }

    </script>
}