@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="hero-section slider">

    <div class="slides">

        <div class="slide active" style="--bg:url('/images/cafe.jpg')">
            <div class="hero-content">
                <div class="decorative-logo">
                    <img src="~/images/logo.jpg" class="decorative-logo-img">
                </div>
                <h1>COFFEE HV</h1>
                <p class="description">Lorem ipsum dolor sit amet...</p>
                <a href="#" class="shop-button">SHOP HERE</a>
            </div>
        </div>

        <div class="slide" style="--bg:url('/images/cafe2.jpg')">
            <div class="hero-content">
                <div class="decorative-logo">
                    <img src="~/images/logo.jpg" class="decorative-logo-img">
                </div>
                <h1>COFFEE HƯƠNG VỊ ĐẶC BIỆT</h1>
                <p class="description">Những dòng cà phê được chọn lọc...</p>
                <a href="#" class="shop-button">XEM THÊM</a>
            </div>
        </div>

        <div class="slide" style="--bg:url('/images/cafe3.jpg')">
            <div class="hero-content">
                <div class="decorative-logo">
                    <img src="~/images/logo.jpg" class="decorative-logo-img">
                </div>
                <h1>COFFEE FOR LIFE</h1>
                <p class="description">Hãy bắt đầu ngày mới bằng một ly cà phê...</p>
                <a href="#" class="shop-button">MUA NGAY</a>
            </div>
        </div>

    </div>

    <div class="slide-control left-arrow prev">
        <i class="fas fa-chevron-left"></i>
    </div>

    <div class="slide-control right-arrow next">
        <i class="fas fa-chevron-right"></i>
    </div>

</section>

<div class="bg-surface text-on-surface">

    <div class="flex w-full">

        <!-- SIDEBAR -->
        <aside class="w-64 sticky top-0 h-screen bg-[#fbf9f4] dark:bg-stone-950 flex flex-col px-4 py-4">
            <div class="mb-8 px-4">
                <h3 class="font-['Manrope'] text-sm uppercase tracking-widest text-[#765a1f] dark:text-[#c6a361] font-bold">Collections</h3>
                <p class="text-[10px] uppercase tracking-[0.2em] text-on-surface-variant/60">Artisanal Selection</p>
            </div>

            <nav class="flex flex-col gap-1">

                <!-- Menu -->
                <a onclick="scrollToCategory('')"
                   class="flex items-center gap-3 px-4 py-3 cursor-pointer">
                    <span>Menu</span>
                </a>

                <!-- Cà phê -->
                <a onclick="scrollToCategory('Cà phê')"
                   class="flex items-center gap-3 px-4 py-3 cursor-pointer">
                    <span>Cà phê</span>
                </a>

                <!-- Bánh ngọt -->
                <a onclick="scrollToCategory('Bánh ngọt')"
                   class="flex items-center gap-3 px-4 py-3 cursor-pointer">
                    <span>Bánh ngọt</span>
                </a>

                <!-- Đồ ăn vặt -->
                <a onclick="scrollToCategory('Đồ ăn vặt')"
                   class="flex items-center gap-3 px-4 py-3 cursor-pointer">
                    <span>Đồ ăn vặt</span>
                </a>

                <!-- Nước ép -->
                <a onclick="scrollToCategory('Nước ép')"
                   class="flex items-center gap-3 px-4 py-3 cursor-pointer">
                    <span>Nước ép</span>
                </a>

                <!-- Trà sữa -->
                <a onclick="scrollToCategory('Trà sữa')"
                   class="flex items-center gap-3 px-4 py-3 cursor-pointer">
                    <span>Trà sữa</span>
                </a>

            </nav>
        </aside>
        <!-- Main Content Area -->
        <div id="productContainer" class="flex-1 overflow-hidden"></div>
    </div>
 </div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@section Scripts {
    <script>
        let index = 0;
        const slides = document.querySelectorAll('.slide');
        const total = slides.length;

        function showSlide(i) {
            slides.forEach(s => s.classList.remove('active'));
            slides[i].classList.add('active');
        }

        document.querySelector('.next').onclick = function () {
            index = (index + 1) % total;
            showSlide(index);
        };

        document.querySelector('.prev').onclick = function () {
            index = (index - 1 + total) % total;
            showSlide(index);
        };

        setInterval(() => {
            index = (index + 1) % total;
            showSlide(index);
        }, 5000);

        function loadProducts() {
            $.ajax({
                url: "/Home/LoadProducts", 
                method: "GET",
                success: function (html) {
                    $("#productContainer").html(html);
                    initSlider();
                }
            });
        }

        // Gọi khi trang vừa load
        $(document).ready(function () {
            loadProducts();
        }); 
                function scrollToCategory(category) {
            if (category === "") {
                window.scrollTo({ top: 0, behavior: "smooth" });
                return;
            }

            const el = document.getElementById("category-" + category);

            if (el) {
                el.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        }
    </script>
}
