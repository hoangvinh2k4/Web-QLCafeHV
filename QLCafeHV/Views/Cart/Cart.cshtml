@using QLCafeHV.Models.ViewModels
@model QLCafeHV.Models.ViewModels.CartViewModel

@{
    var details = Model?.Details ?? new List<CartDetailViewModel>();

    decimal subtotal = details.Sum(x => x.UnitPrice * x.Quantity);
    decimal shipping = 0;
    decimal total = subtotal + shipping;
}

<main class="max-w-7xl mx-auto px-8 mt-20 pb-24">

    <h1 class="text-4xl font-bold mb-10">
        Giỏ hàng của bạn
    </h1>

    <div class="flex flex-col lg:flex-row gap-12">

        <!-- LEFT -->
        <div class="flex-grow space-y-6">

            @if (Model == null || Model.Order == null || Model.Details == null || !Model.Details.Any())
            {
                <div class="text-center py-10 text-gray-500 text-lg">
                    🛒 Giỏ hàng trống
                </div>
            }
            else
            {
                @foreach (var item in Model.Details)
                {
                    <div class="cart-item flex items-center gap-6 bg-white p-6 rounded-xl shadow">

                        <img src="@item.ImageUrl"
                             class="w-32 h-32 object-cover rounded-lg" />

                        <div class="flex-grow">

                            <h3 class="text-xl font-bold">@item.ProductName</h3>

                            <p class="text-gray-500 text-sm">
                                Danh mục : @item.CategoryName
                            </p>

                            <div class="flex justify-between items-center mt-4">

                                <p class="font-bold text-lg text-green-700 total-price">
                                    Giá @item.TotalPrice.ToVnd()
                                </p>

                                <div class="flex items-center gap-1 bg-gray-100 px-2 h-10 rounded-full">

                                    <button class="btn-decrease w-8 h-8 flex items-center justify-center bg-gray-300 rounded-full"
                                            data-id="@item.OrderDetailID">
                                        -
                                    </button>

                                    <input type="number"
                                           min="1"
                                           value="@item.Quantity"
                                           class="quantity-input w-12 text-center bg-transparent outline-none"
                                           data-id="@item.OrderDetailID" />

                                    <button class="btn-increase w-8 h-8 flex items-center justify-center bg-gray-300 rounded-full"
                                            data-id="@item.OrderDetailID">
                                        +
                                    </button>

                                </div>

                                <button class="btn-remove flex items-center gap-1 text-sm font-semibold px-3 py-1 rounded-lg hover:bg-red-100 transition"
                                        data-id="@item.OrderDetailID">
                                    🗑 Remove
                                </button>

                            </div>

                        </div>
                    </div>
                }
            }
        </div>

        <!-- RIGHT -->
        @if (Model?.Order != null && Model?.Details?.Any() == true)
        {
        <aside class="w-full lg:w-[380px]">

            <form method="post" action="@Url.Action("Checkout", "Cart")">

                <div class="bg-white p-6 rounded-2xl shadow-lg sticky top-24">

                    <h2 class="text-2xl font-bold mb-6">Chi tiết thanh toán</h2>

                    <input type="hidden" name="orderId" value="@Model?.Order?.OrderID" />

                    <div class="space-y-4 text-sm">

                        <!-- Họ tên -->
                        <div>
                            <label class="block mb-1 font-semibold">Họ và tên : </label>
                            <input type="text" id="fullName" name="FullName"
                                   class="w-full border rounded-lg px-3 py-2"
                                   required />
                        </div>

                        <!-- SĐT -->
                        <div>
                            <label class="block mb-1 font-semibold">Số điện thoại : </label>
                            <input type="text" id="phone" name="Phone"
                                   class="w-full border rounded-lg px-3 py-2"
                                   required />
                        </div>

                        <!-- Quận -->
                        <div>
                            <label class="block mb-1 font-semibold">Quận (Hà Nội)</label>
                            <select id="district" name="District"
                                    class="w-full border rounded-lg px-3 py-2"
                                    required>
                                <option value="">-- Chọn quận --</option>
                                <option value="BaDinh">Ba Đình</option>
                                <option value="HoanKiem">Hoàn Kiếm</option>
                                <option value="DongDa">Đống Đa</option>
                                <option value="HaiBaTrung">Hai Bà Trưng</option>
                                <option value="CauGiay">Cầu Giấy</option>
                                <option value="ThanhXuan">Thanh Xuân</option>
                                <option value="HoangMai">Hoàng Mai</option>
                                <option value="LongBien">Long Biên</option>
                                <option value="HaDong">Hà Đông</option>
                                <option value="NamTuLiem">Nam Từ Liêm</option>
                                <option value="BacTuLiem">Bắc Từ Liêm</option>
                            </select>
                        </div>

                        <!-- Địa chỉ chi tiết -->
                        <div>
                            <label class="block mb-1 font-semibold">Địa chỉ chi tiết : </label>
                            <input type="text" id="address" name="Address"
                                   class="w-full border rounded-lg px-3 py-2"
                                   required />
                        </div>

                        <!-- Tổng tiền sản phẩm -->
                        <div class="flex justify-between">
                            <span>Tổng tiền sản phẩm : </span>
                            <span id="subtotal">@subtotal.ToVnd()</span>
                        </div>

                        <!-- Mã giảm giá -->
                        <div>
                            <label class="block mb-1 font-semibold">Mã giảm giá</label>
                            <input type="text" name="Coupon"
                                   class="w-full border rounded-lg px-3 py-2" />
                        </div>

                        <!-- Phí ship -->
                        <div class="flex justify-between">
                            <span>Phí vận chuyển</span>
                            <span id="shipping"> @shipping.ToVnd()</span>
                        </div>

                        <hr class="my-4" />

                        <!-- Tổng cuối -->
                        <div class="flex justify-between font-bold text-lg">
                            <span>Tổng tiền cần thanh toán : </span>
                            <span id="grandTotal">@total.ToVnd()</span>
                        </div>

                        <!-- Nút -->
                        <button id="btnCheckout"
                                type="button"
                                data-orderid="@Model.Order.OrderID"
                                class="w-full mt-4 bg-green-600 text-white py-3 rounded-full font-bold">
                            Thanh toán
                        </button>

                    </div>

                </div>

            </form>

        </aside>
        }   
    </div>

</main>

<script>
    let currentShipping = 0;
    // ===== FORMAT =====
    function formatMoney(number) {
        return number.toLocaleString("vi-VN") + " đ";
    }

    // ===== UPDATE SUMMARY =====
    function updateSummary() {
        let subtotal = 0;

        document.querySelectorAll(".total-price").forEach(el => {
            const value = parseInt(el.innerText.replace(/\D/g, ""));
            subtotal += value;
        });

        const shipping = currentShipping;
        const total = subtotal + shipping;

        document.getElementById("subtotal").innerText = formatMoney(subtotal);
        document.getElementById("shipping").innerText = formatMoney(shipping);
        document.getElementById("grandTotal").innerText = formatMoney(total);
    }


    // ===== INCREASE =====
    document.querySelectorAll(".btn-increase").forEach(btn => {
        btn.onclick = function () {

            const id = this.dataset.id;
            const item = this.closest(".cart-item");

            fetch("/Cart/IncreaseQuantity", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "id=" + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    item.querySelector(".quantity-input").value = data.quantity;
                    item.querySelector(".total-price").innerText = formatMoney(data.totalPrice);
                    updateSummary();
                }
            });
        }
    });


    // ===== DECREASE =====
    document.querySelectorAll(".btn-decrease").forEach(btn => {
        btn.onclick = function () {

            const id = this.dataset.id;
            const item = this.closest(".cart-item");

            fetch("/Cart/DecreaseQuantity", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "id=" + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    item.querySelector(".quantity-input").value = data.quantity;
                    item.querySelector(".total-price").innerText = formatMoney(data.totalPrice);
                    updateSummary();
                }
            });
        }
    });

    // ===== INPUT CHANGE =====
    document.querySelectorAll(".quantity-input").forEach(input => {
        input.addEventListener("change", function () {

            const id = this.dataset.id;
            let quantity = parseInt(this.value);

            if (isNaN(quantity) || quantity < 1) {
                quantity = 1;
                this.value = 1;
            }

            const item = this.closest(".cart-item");

            fetch("/Cart/UpdateQuantity", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    id: parseInt(id),
                    quantity: quantity
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    this.value = data.quantity;
                    item.querySelector(".total-price").innerText = formatMoney(data.totalPrice);
                    updateSummary();
                }
            });
        });
    });
    // == XÓA SẢN PHẨM KHỎI GIỎ HÀNG
    document.querySelectorAll(".btn-remove").forEach(btn => {
        btn.addEventListener("click", function () {

            const id = this.dataset.id;
            const item = this.closest(".cart-item");

            Swal.fire({
                title: "Xóa sản phẩm?",
                text: "Bạn có chắc muốn xóa khỏi giỏ hàng?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#16a34a",
                cancelButtonColor: "#d33",
                confirmButtonText: "Xóa",
                cancelButtonText: "Hủy"
            }).then((result) => {

                if (result.isConfirmed) {

                    fetch("/Cart/RemoveItem", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded"
                        },
                        body: "orderDetailId=" + id
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {

                            // Xóa UI
                            item.remove();

                            // Update tiền
                            updateSummary();

                            Swal.fire({
                                icon: "success",
                                title: "Đã xóa!",
                                text: "Sản phẩm đã được xóa khỏi giỏ hàng",
                                timer: 1500,
                                showConfirmButton: false
                            });

                        } else {
                            Swal.fire("Lỗi", data.message, "error");
                        }
                    });

                }
            });
        });
    });
        // ===== SHIPPING BY DISTRICT =====
    const districtSelect = document.getElementById("district");

    const shippingMap = {
        BaDinh: 15000,
        HoanKiem: 15000,
        DongDa: 18000,
        HaiBaTrung: 18000,
        CauGiay: 20000,
        ThanhXuan: 20000,
        HoangMai: 22000,
        LongBien: 25000,
        HaDong: 30000,
        NamTuLiem: 25000,
        BacTuLiem: 25000
    };

    districtSelect.addEventListener("change", function () {

        const district = this.value;

        currentShipping = shippingMap[district] || 0;

        // update UI ngay
        document.getElementById("shipping").innerText = formatMoney(currentShipping);

        // gọi lại tính tổng
        updateSummary();
    });
         const btn = document.getElementById("btnCheckout");

    if (btn) {
        btn.addEventListener("click", function (e) {
            e.preventDefault();

            const orderid = Number(btn.dataset.orderid);

            // ✅ validate
            if (!orderid || isNaN(orderid)) {
                alert("OrderID không hợp lệ");
                return;
            }

            const request = {
                orderID: orderid,
                fullName: document.getElementById("fullName").value,
                phone: document.getElementById("phone").value,
                address: document.getElementById("address").value,
                district: document.getElementById("district").value,
                smartcardSerial: "123456789",
                package: "Goi VIP",
                months: 3,
                payType: ""
            };

            fetch('/Pay/ThanhToanTrucTuyen', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(request)
            })
            .then(res => res.json())
            .then(data => {
                if (data.responseCode > 0 && data.paymentUrl) {
                    window.location.href = data.paymentUrl;
                } else {
                    alert(data.description);
                }
            })
            .catch(err => console.error("Lỗi:", err));
        });
    }
</script>