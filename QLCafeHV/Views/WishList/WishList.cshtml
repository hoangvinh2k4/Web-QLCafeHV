@{
    var details = new List<dynamic>
    {
        new {
            ProductName = "Midnight Velvet Cold Brew",
            ImageUrl = "https://images.unsplash.com/photo-1511920170033-f8396924c348",
            UnitPrice = 6.50m,
            Quantity = 2,
            TotalPrice = 13.00m
        },
        new {
            ProductName = "Effervescent Matcha Bloom",
            ImageUrl = "https://images.unsplash.com/photo-1515823064-d6e0c04616a7",
            UnitPrice = 5.75m,
            Quantity = 1,
            TotalPrice = 5.75m
        },
        new {
            ProductName = "Sun-Drenched Citron",
            ImageUrl = "https://images.unsplash.com/photo-1528825871115-3581a5387919",
            UnitPrice = 4.50m,
            Quantity = 3,
            TotalPrice = 13.50m
        }
    };

    decimal subtotal = 32.25m;
    decimal shipping = 5.00m;
    decimal tax = subtotal * 0.08m;
    decimal total = subtotal + shipping + tax;
}

<main class="max-w-7xl mx-auto px-8 pt-12 pb-24">

    <h1 class="text-4xl font-bold mb-10">
        Order #TEST-001
    </h1>

    <div class="flex flex-col lg:flex-row gap-12">

        <!-- CART ITEMS -->
        <div class="flex-grow space-y-6">

            @foreach (var item in details)
            {
                <div class="flex items-center gap-6 bg-white p-6 rounded-xl shadow hover:shadow-lg transition">

                    <img src="@item.ImageUrl"
                         class="w-32 h-32 object-cover rounded-lg" />

                    <div class="flex-grow">

                        <h3 class="text-xl font-bold">@item.ProductName</h3>

                        <p class="text-gray-500 text-sm">
                            Unit Price: $@item.UnitPrice
                        </p>

                        <div class="flex justify-between items-center mt-4">

                            <p class="font-bold text-lg text-green-700">
                                $@item.TotalPrice
                            </p>

                            <div class="flex items-center gap-3 bg-gray-100 px-3 py-1 rounded-full">
                                <button class="px-2">-</button>
                                <span class="font-bold">@item.Quantity</span>
                                <button class="px-2">+</button>
                            </div>

                            <button class="text-red-500 text-sm font-semibold">
                                Remove
                            </button>

                        </div>

                    </div>
                </div>
            }

        </div>

        <!-- SUMMARY -->
        <aside class="w-full lg:w-[380px]">

            <div class="bg-white p-6 rounded-2xl shadow-lg sticky top-24">

                <h2 class="text-2xl font-bold mb-6">Order Summary</h2>

                <div class="space-y-3 text-sm">

                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span>$@subtotal.ToString("0.00")</span>
                    </div>

                    <div class="flex justify-between">
                        <span>Shipping</span>
                        <span>$@shipping</span>
                    </div>

                    <div class="flex justify-between">
                        <span>Tax</span>
                        <span>$@tax.ToString("0.00")</span>
                    </div>

                    <hr class="my-4" />

                    <div class="flex justify-between font-bold text-lg">
                        <span>Total</span>
                        <span class="text-green-700">$@total.ToString("0.00")</span>
                    </div>

                </div>

                <button class="w-full mt-6 bg-green-600 text-white py-3 rounded-full font-bold hover:bg-green-700 transition">
                    Proceed to Checkout
                </button>

            </div>

        </aside>

    </div>

</main>