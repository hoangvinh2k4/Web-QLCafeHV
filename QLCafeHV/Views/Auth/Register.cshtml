@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - CukCuk Admin</title>
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-header">
                <img src="~/images/logo.jpg" alt="Logo" class="logo" />
                <h2>Tạo tài khoản mới</h2>
                <p>Tham gia hệ thống quản lý CukCuk dễ dàng</p>
            </div>
            <form id="registerForm" class="auth-form" autocomplete="off">
                <div class="input-group">
                    <label>Tên đăng nhập</label>
                    <input type="text" id="username" name="username" autocomplete="off" required />
                    <small id="usernameMessage"></small>
                </div>

                <div class="input-group">
                    <label>Họ và tên</label>
                    <input type="text" id="fullname" name="fullname" required />
                </div>

                <div class="input-group">
                    <label>Địa chỉ</label>
                    <input type="text" id="address" name="address" required />
                </div>

                <div class="input-group">
                    <label>Email</label>
                    <input type="text" id="email" name="email" required />
                </div>

                <div class="input-group">
                    <label>Số điện thoại</label>
                    <input type="text" id="phone" name="phone" required />
                </div>

                <div class="input-group">
                    <label>Căn cước công dân</label>
                    <input type="text" id="cccd" name="cccd" required />
                </div>

                <div class="input-group">
                    <label>Mật khẩu</label>
                    <input type="password" id="password" name="password" autocomplete="new-password" required />
                </div>

                <div class="input-group">
                    <label>Xác nhận mật khẩu</label>
                    <input type="password" id="confirm" required />
                </div>

                <button type="submit" class="btn-primary">Đăng ký</button>

                <p class="switch-form">
                    Đã có tài khoản? <a asp-action="Login">Đăng nhập</a>
                </p>
            </form>
        </div>
    </div>
</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $("#registerForm").submit(function (e) {
        e.preventDefault();

        let password = $("#password").val();
        let confirm = $("#confirm").val();

        if (password !== confirm) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: 'Mật khẩu xác nhận không khớp!'
            });
            return;
        }

        $.ajax({
            url: '@Url.Action("Register", "Auth")',
            type: 'POST',
            data: {
                username: $("#username").val(),
                fullname: $("#fullname").val(),
                address: $("#address").val(),
                cccd: $("#cccd").val(),
                email: $("#email").val(),
                phone: $("#phone").val(),
                password: password
            },
            success: function (res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đăng ký thành công 🎉',
                        text: res.message
                    }).then(() => {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: res.message
                    });
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi server',
                    text: 'Không thể đăng ký!'
                });
            }
        });
    });
</script>
<script>
    $("#username").blur(function () {
        var username = $(this).val();

        $.ajax({
            url: '@Url.Action("CheckUsername", "Auth")',
            type: 'POST',
            data: { username: username },
            success: function (res) {
                if (res.exists) {
                    $("#usernameMessage").text("Tên đăng nhập đã tồn tại").css("color", "red");
                } else {
                    $("#usernameMessage").text("");
                }
            }
        });
    });
</script>   